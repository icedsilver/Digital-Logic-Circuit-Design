  <vhdl appearance="logisim_evolution" name="problem1">library ieee;
use ieee.std_logic_1164.all;

entity problem1 is
    port (
        a    : in  std_logic;
        b    : in  std_logic;
        c    : in  std_logic;
        d    : in  std_logic;
        out1 : out std_logic;
        out2 : out std_logic
    );
end problem1;

architecture behavioral of problem1 is
begin
    out1 &lt;= a and b and c and d;
    out2 &lt;= a or b or c or d;
end behavioral;</vhdl>
  <vhdl appearance="logisim_evolution" name="mux8to1">library ieee;
use ieee.std_logic_1164.all;

entity mux8to1 is
    port (
        d   : in  std_logic_vector(7 downto 0);
        sel : in  std_logic_vector(2 downto 0);
        y   : out std_logic
    );
end mux8to1;

architecture behavioral of mux8to1 is
begin
    with sel select
        y &lt;= d(0) when "000",
             d(1) when "001",
             d(2) when "010",
             d(3) when "011",
             d(4) when "100",
             d(5) when "101",
             d(6) when "110",
             d(7) when "111",
             '0'  when others;
end behavioral;</vhdl>
  <vhdl appearance="logisim_evolution" name="seg_letters">library ieee;
use ieee.std_logic_1164.all;

entity seg_letters is
    port (
        sel : in  std_logic_vector(2 downto 0);
        seg : out std_logic_vector(6 downto 0) -- gfedcba
    );
end seg_letters;

architecture behavioral of seg_letters is
begin
    process(sel)
    begin
        -- 비트 순서: "gfedcba" (1: 켜짐, 0: 꺼짐)
        case sel is
            when "000" =&gt; seg &lt;= "1110111"; -- A
            when "001" =&gt; seg &lt;= "1111100"; -- b
            when "010" =&gt; seg &lt;= "0111001"; -- C
            when "011" =&gt; seg &lt;= "1011110"; -- d
            when "100" =&gt; seg &lt;= "1110001"; -- F
            when "101" =&gt; seg &lt;= "0111101"; -- G
            when others =&gt; seg &lt;= "0000000"; -- OFF
        end case;
    end process;
end behavioral;</vhdl>
  <vhdl appearance="logisim_evolution" name="voting25">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity voting25 is
    port (
        votes : in  std_logic_vector(24 downto 0);
        pass  : out std_logic
    );
end voting25;

architecture behavioral of voting25 is
begin
    process(votes)
        variable cnt : integer range 0 to 25;
    begin
        cnt := 0;
        for i in 0 to 24 loop
            if votes(i) = '1' then
                cnt := cnt + 1;
            end if;
        end loop;

        if cnt &gt;= 13 then
            pass &lt;= '1';
        else
            pass &lt;= '0';
        end if;
    end process;
end behavioral;</vhdl>
  <vhdl appearance="logisim_evolution" name="ones_counter_seg">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity ones_counter_seg is
    port (
        vt  : in  std_logic_vector(12 downto 0);
        en  : in  std_logic;
        seg : out std_logic_vector(6 downto 0)
    );
end ones_counter_seg;

architecture behavioral of ones_counter_seg is
begin
    process(vt, en)
        variable cnt : integer range 0 to 15;
    begin
        cnt := 0;
        for i in 0 to 12 loop
            if vt(i) = '1' then
                cnt := cnt + 1;
            end if;
        end loop;

        if en = '0' then
            seg &lt;= "0000000"; -- en='0'이면 화면 끔
        else
            case cnt is
                when 0  =&gt; seg &lt;= "0111111"; -- 0
                when 1  =&gt; seg &lt;= "0000110"; -- 1
                when 2  =&gt; seg &lt;= "1011011"; -- 2
                when 3  =&gt; seg &lt;= "1001111"; -- 3
                when 4  =&gt; seg &lt;= "1100110"; -- 4
                when 5  =&gt; seg &lt;= "1101101"; -- 5
                when 6  =&gt; seg &lt;= "1111101"; -- 6
                when 7  =&gt; seg &lt;= "0000111"; -- 7
                when 8  =&gt; seg &lt;= "1111111"; -- 8
                when 9  =&gt; seg &lt;= "1101111"; -- 9
                when 10 =&gt; seg &lt;= "1110111"; -- A
                when 11 =&gt; seg &lt;= "1111100"; -- b
                when 12 =&gt; seg &lt;= "0111001"; -- C
                when 13 =&gt; seg &lt;= "1011110"; -- d
                when 14 =&gt; seg &lt;= "1111001"; -- E
                when 15 =&gt; seg &lt;= "1110001"; -- F
                when others =&gt; seg &lt;= "0000000";
            end case;
        end if;
    end process;
end behavioral;</vhdl>
