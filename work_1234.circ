  <vhdl appearance="logisim_evolution" name="rs_latch">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY rs_latch IS
    PORT (
        s  : IN  std_logic;
        r  : IN  std_logic;
        q  : OUT std_logic;
        nq : OUT std_logic
    );
END rs_latch;

ARCHITECTURE bhv OF rs_latch IS
    SIGNAL q_int, nq_int : std_logic;
BEGIN
    q_int  &lt;= r NOR nq_int;
    nq_int &lt;= s NOR q_int;
    q      &lt;= q_int;
    nq     &lt;= nq_int;
END bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="d_latch">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY d_latch IS
    PORT (
        en : IN  std_logic;
        d  : IN  std_logic;
        q  : OUT std_logic
    );
END d_latch;

ARCHITECTURE bhv OF d_latch IS
BEGIN
    PROCESS (en, d)
    BEGIN
        IF (en = '1') THEN
            q &lt;= d;
        END IF;
    END PROCESS;
END bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="d_ff">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY d_ff IS
    PORT (
        clk : IN  std_logic;
        d   : IN  std_logic;
        q   : OUT std_logic
    );
END d_ff;

ARCHITECTURE bhv OF d_ff IS
BEGIN
    PROCESS (clk)
    BEGIN
        IF rising_edge(clk) THEN
            q &lt;= d;
        END IF;
    END PROCESS;
END bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="jk_ff">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY jk_ff IS
    PORT (
        clk : IN  std_logic;
        j   : IN  std_logic;
        k   : IN  std_logic;
        q   : OUT std_logic
    );
END jk_ff;

ARCHITECTURE bhv OF jk_ff IS
    SIGNAL q_internal : std_logic := '0';
BEGIN
    q &lt;= q_internal;

    PROCESS (clk)
    BEGIN
        IF rising_edge(clk) THEN
            IF (j = '0' AND k = '0') THEN
                q_internal &lt;= q_internal;     -- Hold
            ELSIF (j = '0' AND k = '1') THEN
                q_internal &lt;= '0';            -- Reset
            ELSIF (j = '1' AND k = '0') THEN
                q_internal &lt;= '1';            -- Set
            ELSIF (j = '1' AND k = '1') THEN
                q_internal &lt;= NOT q_internal; -- Toggle
            END IF;
        END IF;
    END PROCESS;
END bhv;</vhdl>
  <vhdl appearance="logisim_evolution" name="d_ff_async">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY d_ff_async IS
    PORT (
        clk : IN  std_logic;
        d   : IN  std_logic;
        clr : IN  std_logic;
        set : IN  std_logic;
        q   : OUT std_logic
    );
END d_ff_async;

ARCHITECTURE bhv OF d_ff_async IS
    SIGNAL q_int : std_logic := '0';
BEGIN
    q &lt;= q_int;

    PROCESS (clk, clr, set)
    BEGIN
        -- 1순위: 비동기 Clear (클럭 무관 즉시 0)
        IF (clr = '1') THEN
            q_int &lt;= '0';
        -- 2순위: 비동기 Set (클럭 무관 즉시 1)
        ELSIF (set = '1') THEN
            q_int &lt;= '1';
        -- 3순위: 동기 D Flip-Flop 동작 (클럭 상승 에지)
        ELSIF rising_edge(clk) THEN
            q_int &lt;= d;
        END IF;
    END PROCESS;
END bhv;

</vhdl>
</project>
